:root {
  font-family: Inter, Arial, Helvetica, sans-serif;
  color: #282b30;
  background: #fff;
  font-synthesis: none;
  --wine: #67312f;
  --wine-dark: #502724;
  --line: #e4e4e6;
  --muted: #69717c;
  --gold: #ffe184;
}
* {
  box-sizing: border-box;
}
body {
  margin: 0;
}
button,
input,
select {
  font: inherit;
}
button,
a,
input,
select {
  touch-action: manipulation;
}
button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 11px 17px;
  border: 1px solid transparent;
  border-radius: 6px;
  background: var(--wine);
  color: white;
  cursor: pointer;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.3;
}
button:hover {
  filter: brightness(0.95);
}
button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}
input,
select {
  width: 100%;
  padding: 12px;
  border: 1px solid #cfd1d5;
  border-radius: 6px;
  background: #fff;
  color: #282b30;
  min-width: 0;
  font-size: 16px;
}
input[type='file'] {
  font-size: 14px;
}
input:focus-visible,
select:focus-visible,
button:focus-visible,
a:focus-visible,
summary:focus-visible {
  outline: 3px solid #be9254;
  outline-offset: 3px;
}
a {
  color: var(--wine);
}
svg {
  flex-shrink: 0;
}
h1,
h2,
h3,
p {
  margin-top: 0;
}
h3 {
  font-size: 18px;
  display: flex;
  align-items: center;
  gap: 9px;
}
p {
  line-height: 1.65;
}
.secondary {
  background: white;
  border-color: var(--line);
  color: #4c4f55;
}
.small {
  font-size: 13px;
  padding: 8px 12px;
}
.icon-button {
  background: transparent;
  color: inherit;
  border: 0;
  padding: 9px;
  min-width: 38px;
  min-height: 38px;
}
.danger {
  background: #a82e30;
}
.danger-text {
  color: #a82e30;
}
.hint {
  font-size: 13px;
  line-height: 1.6;
  color: var(--muted);
}
.eyebrow {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--wine);
  margin-bottom: 14px;
}
.error {
  color: #9d1c29;
  background: #fff0f1;
  border: 1px solid #f2d2d7;
  padding: 12px 15px;
  border-radius: 6px;
  font-size: 14px;
  overflow-wrap: anywhere;
}
.success {
  color: #255c41;
  background: #f0f8f2;
  border: 1px solid #d5e8db;
  padding: 12px 15px;
  border-radius: 6px;
  font-size: 14px;
}
.spin {
  animation: spin 1s linear infinite;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
.setup {
  max-width: 700px;
  padding: 60px 25px;
  margin: 5vh auto;
}
.setup > svg {
  color: var(--wine);
  margin-bottom: 24px;
}
.setup h1 {
  font-family: Georgia, serif;
  font-size: 42px;
  color: var(--wine);
  font-weight: 400;
}
.setup li {
  margin: 16px 0;
  line-height: 1.7;
}
.setup code {
  background: #f2efef;
  padding: 4px 6px;
  border-radius: 4px;
}
.auth-screen {
  min-height: 100vh;
  background: #f6f5f4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32px 20px;
}
.auth-card {
  max-width: 490px;
  width: 100%;
  border: 1px solid #e2dbd8;
  border-top: 4px solid var(--wine);
  background: white;
  padding: 42px;
  border-radius: 10px;
  box-shadow: 0 20px 60px #43221a08;
}
.auth-card > svg {
  color: var(--wine);
  margin-bottom: 25px;
}
.auth-card h1 {
  font-family: Georgia, serif;
  font-size: 36px;
  line-height: 1.2;
  font-weight: 400;
  color: var(--wine);
}
.auth-card > p:not(.eyebrow):not(.error) {
  color: var(--muted);
  font-size: 15px;
}
.auth-card > button {
  width: 100%;
  margin-top: 12px;
  min-height: 46px;
}
.auth-foot {
  border-top: 1px solid var(--line);
  padding-top: 20px;
  margin: 28px 0 0 !important;
  font-size: 12px !important;
}
.account-email {
  font-weight: 600;
  overflow-wrap: anywhere;
}
.app-shell {
  min-height: 100vh;
}
.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 300px;
  background: var(--wine);
  color: #f4e9e5;
  display: flex;
  flex-direction: column;
  z-index: 30;
  border-right: 1px solid #492522;
}
.sidebar-brand {
  padding: 25px 23px;
  display: flex;
  align-items: flex-start;
  gap: 12px;
  font-family: Georgia, serif;
  font-size: 20px;
  line-height: 1.4;
  border-bottom: 1px solid #ffffff20;
}
.sidebar-brand > svg {
  margin-top: 3px;
}
.sidebar-search {
  margin: 22px 18px 16px;
  display: flex;
  align-items: center;
  gap: 9px;
  border: 1px solid #ffffff30;
  border-radius: 6px;
  padding: 0 10px;
  background: #00000012;
}
.sidebar-search input {
  padding: 11px 0;
  background: transparent;
  border: none;
  color: white;
  font-size: 14px;
}
.sidebar-search input::placeholder {
  color: #e0c4be;
}
.sidebar-label {
  padding: 4px 23px;
  color: #d9bdb7;
  font-size: 11px;
  letter-spacing: 0.09em;
  font-weight: 700;
  display: flex;
  justify-content: space-between;
}
.sidebar nav {
  overflow: auto;
  flex: 1;
  padding: 0 10px 25px;
  scrollbar-width: thin;
  scrollbar-color: #ac7b72 transparent;
}
.sidebar details {
  margin-bottom: 8px;
}
.sidebar summary {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 12px 13px;
  cursor: pointer;
  list-style: none;
  font-weight: 600;
  font-size: 15px;
  overflow-wrap: anywhere;
}
.sidebar summary::after {
  content: '−';
  margin-left: auto;
  color: #dcbeb7;
}
.sidebar details:not([open]) summary::after {
  content: '+';
}
.sidebar details > div {
  padding-left: 13px;
}
.document-link {
  width: 100%;
  text-align: left;
  justify-content: flex-start;
  align-items: flex-start;
  padding: 10px 13px;
  background: transparent;
  color: #f0e2df;
  border-radius: 4px;
  font-weight: 400;
  gap: 9px;
}
.document-link svg {
  margin-top: 3px;
  opacity: 0.7;
}
.document-link span {
  overflow-wrap: anywhere;
  font-size: 14px;
  line-height: 1.45;
  min-width: 0;
}
.document-link small {
  font-size: 10px;
  display: block;
  color: #c9a69f;
  margin-top: 3px;
  letter-spacing: 0.07em;
}
.document-link:hover {
  background: #ffffff0c;
  filter: none;
}
.document-link.selected {
  background: #ffffff12;
  color: var(--gold);
  box-shadow: inset 3px 0 var(--gold);
}
.document-link.selected small {
  color: #ecd291;
}
.unfiled > p {
  font-size: 13px;
  color: #d8b7ae;
  padding: 9px 13px;
  margin: 0;
}
.sidebar-empty {
  font-size: 14px;
  color: #e1c5be;
  margin: 15px;
}
.sidebar-footer {
  border-top: 1px solid #ffffff22;
  padding: 20px 23px;
  display: flex;
  gap: 9px;
  font-size: 12px;
  color: #e2c5be;
}
.main-pane {
  margin-left: 300px;
  min-width: 0;
}
.topbar {
  height: 70px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 0 32px;
  border-bottom: 1px solid #eee;
  position: sticky;
  top: 0;
  background: #fffffff2;
  z-index: 20;
  backdrop-filter: blur(8px);
}
.topbar-label {
  font-size: 13px;
  color: #8a8d93;
  overflow-wrap: anywhere;
}
.topbar-label strong {
  color: #646971;
  font-weight: 400;
}
.topbar-actions {
  display: flex;
  align-items: center;
  gap: 14px;
}
.topbar-actions > button {
  font-size: 13px;
}
.user-email {
  font-size: 12px;
  color: #81868e;
  max-width: 190px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.reading-main {
  max-width: 1120px;
  padding: 64px 60px 35px;
  margin: auto;
}
.document-heading {
  border-bottom: 2px solid var(--wine);
  padding-bottom: 20px;
  margin-bottom: 32px;
}
.document-heading > div {
  display: flex;
  align-items: flex-start;
  gap: 20px;
  justify-content: space-between;
}
.document-heading h1 {
  color: var(--wine);
  font-size: 36px;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: -0.025em;
  margin: 0;
  overflow-wrap: anywhere;
}
.document-actions {
  display: flex;
  gap: 8px;
  flex-shrink: 0;
}
.document-actions button {
  padding: 9px 11px;
  font-size: 13px;
}
.reader-empty {
  min-height: 350px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 13px;
  padding: 35px 20px;
  color: #85888d;
}
.reader-empty h2 {
  font-family: Georgia, serif;
  font-size: 25px;
  font-weight: 400;
  color: #5b5351;
  line-height: 1.4;
  margin: 8px 0 0;
}
.reader-empty p {
  font-size: 15px;
  max-width: 440px;
  margin: 0;
}
.empty-action {
  text-align: center;
  margin-top: -35px;
  padding-bottom: 45px;
}
.markdown {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 20px;
  line-height: 1.8;
  color: #25262a;
  overflow-wrap: anywhere;
}
.markdown h1,
.markdown h2,
.markdown h3,
.markdown h4 {
  font-family: Arial, sans-serif;
  color: var(--wine);
  line-height: 1.35;
  margin: 1.5em 0 0.65em;
}
.markdown h1 {
  font-size: 32px;
}
.markdown h2 {
  font-size: 27px;
}
.markdown h3 {
  font-size: 23px;
}
.markdown p {
  line-height: 1.8;
  margin-bottom: 1.1em;
}
.markdown blockquote {
  border-left: 3px solid #9a5b54;
  margin-left: 0;
  padding: 7px 20px;
  background: #faf6f5;
  color: #67524e;
}
.markdown pre,
.source-reader {
  overflow: auto;
  font:
    14px/1.7 Consolas,
    'Courier New',
    monospace;
  background: #f6f5f4;
  border: 1px solid #e7e4e2;
  padding: 22px;
  border-radius: 7px;
}
.markdown code:not(pre code) {
  font-size: 0.85em;
  background: #f2eeee;
  padding: 2px 5px;
  border-radius: 4px;
}
.markdown table {
  display: block;
  max-width: 100%;
  overflow: auto;
  border-collapse: collapse;
  font-size: 16px;
}
.markdown th,
.markdown td {
  padding: 10px 13px;
  border: 1px solid var(--line);
}
.markdown .katex-display {
  overflow: auto;
  padding: 8px 0;
}
.attachment-note {
  font:
    14px/1.5 Arial,
    sans-serif;
  color: #736661;
}
.source-reader {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.pdf-reader {
  width: 100%;
  height: 73vh;
  border: 1px solid var(--line);
  background: #f5f5f5;
  border-radius: 6px;
  display: block;
}
.pdf-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 12px;
  font: 14px/1.5 Arial, sans-serif;
}
.pdf-toolbar a {
  color: inherit;
  text-decoration: underline;
  text-underline-offset: 3px;
}
.pdf-help {
  margin: 10px 0 0;
  font: 13px/1.5 Arial, sans-serif;
  color: #736661;
}
.image-reader {
  max-width: 100%;
  max-height: 75vh;
  display: block;
  margin: auto;
  object-fit: contain;
}
.reading-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid var(--line);
  padding-top: 24px;
  margin-top: 45px;
  font-size: 13px;
  color: #868b94;
}
.reading-footer button {
  border: 0;
  color: var(--wine);
  font-weight: 400;
}
.banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin: 20px 30px;
}
.mobile-only,
.sidebar-backdrop {
  display: none;
}
dialog {
  border: 1px solid var(--line);
  border-radius: 12px;
  max-width: 650px;
  width: calc(100% - 32px);
  max-height: 90vh;
  padding: 0;
  box-shadow: 0 20px 70px #0003;
  color: #282b30;
}
dialog::backdrop {
  background: #25202085;
  backdrop-filter: blur(2px);
}
.modal-inner {
  padding: 28px;
}
.modal-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 24px;
}
.modal-heading h2 {
  font-size: 22px;
  margin: 0;
  color: var(--wine);
  font-weight: 600;
}
.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 24px;
}
.switcher {
  display: flex;
  border-bottom: 1px solid var(--line);
  gap: 8px;
  margin-bottom: 25px;
}
.switcher button {
  border-radius: 6px 6px 0 0;
  background: transparent;
  color: var(--muted);
  padding: 12px;
}
.switcher button[aria-pressed='true'] {
  color: var(--wine);
  box-shadow: inset 0 -2px var(--wine);
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.stack h3 {
  margin: 0 0 6px;
}
.stack label {
  font-size: 14px;
  font-weight: 500;
  margin-top: 5px;
}
.stack > button {
  align-self: flex-start;
  margin-top: 8px;
}
.stack .hint {
  margin: 0;
}
.separated {
  border-top: 1px solid var(--line);
  padding-top: 25px;
  margin-top: 28px;
}
.inline-form {
  display: flex;
  gap: 10px;
}
.member-list {
  list-style: none;
  padding: 0;
  margin-top: 25px;
}
.member-list li {
  padding: 17px 0;
  border-top: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
}
.member-list li > div {
  min-width: 0;
}
.member-list strong {
  display: block;
  font-size: 14px;
  overflow-wrap: anywhere;
}
.member-list span {
  display: block;
  font-size: 12px;
  color: var(--muted);
  margin-top: 5px;
}
.member-list button {
  flex-shrink: 0;
}
@media (max-width: 1150px) {
  .sidebar {
    width: 260px;
  }
  .main-pane {
    margin-left: 260px;
  }
  .reading-main {
    padding: 42px 35px;
  }
  .user-email {
    display: none;
  }
  .document-heading > div {
    flex-direction: column;
    gap: 18px;
  }
  .document-heading h1 {
    font-size: 33px;
  }
}
@media (max-width: 780px) {
  .mobile-only {
    display: inline-flex;
  }
  .sidebar {
    width: 290px;
    transform: translateX(-100%);
    transition: transform 0.2s;
  }
  .sidebar.open {
    transform: translateX(0);
  }
  .sidebar-brand {
    padding: 20px 16px;
  }
  .sidebar-brand > span {
    flex: 1;
  }
  .sidebar-brand .icon-button {
    margin-top: -4px;
  }
  .sidebar-backdrop {
    display: block;
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0;
    background: #0006;
    z-index: 29;
  }
  .main-pane {
    margin-left: 0;
  }
  .topbar {
    height: 64px;
    padding: 0 15px;
    gap: 12px;
  }
  .topbar-label {
    flex: 1;
    font-size: 12px;
  }
  .topbar-actions {
    gap: 5px;
  }
  .topbar-actions > button {
    padding: 9px;
  }
  .topbar-actions .secondary span {
    display: none;
  }
  .reading-main {
    padding: 32px 22px;
  }
  .document-heading h1 {
    font-size: 29px;
  }
  .markdown {
    font-size: 18px;
  }
  .markdown h1 {
    font-size: 28px;
  }
  .markdown h2 {
    font-size: 24px;
  }
  .pdf-reader {
    height: 65vh;
  }
  .banner {
    margin: 14px;
  }
  .modal-inner {
    padding: 22px;
  }
  .auth-card {
    padding: 30px;
  }
  .auth-card h1 {
    font-size: 30px;
  }
  .member-list li {
    flex-wrap: wrap;
  }
  .source-reader {
    font-size: 13px;
    padding: 15px;
  }
}
@media (prefers-reduced-motion: reduce) {
  .spin {
    animation: none;
  }
  .sidebar {
    transition: none;
  }
}
